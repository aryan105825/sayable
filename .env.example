# Copy to .env and edit. Every variable is read in one place and validated at startup.

# Pantry (voice-first) server port
PANTRY_PORT=8801
# Baseline (conventional) server port
BASELINE_PORT=8802
# SQLite files for the two servers
PANTRY_DB=data/pantry.db
BASELINE_DB=data/baseline.db

# HMAC secret for Pantry confirmation tokens. Set a long random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
CONFIRM_SECRET=
# Affected-row count at or above which remove_items requires confirmation
CONFIRM_THRESHOLD=3
# Comma-separated Host values Pantry accepts (e.g. 127.0.0.1:8801,localhost:8801,pantry.example.com)
PANTRY_ALLOWED_HOSTS=127.0.0.1:8801,localhost:8801

# Optional: public Pantry URL for the hosted lint step (verify.sh S9)
HOSTED_URL=
# Stretch only: registry API URL for the corpus scan (verify.sh S10)
REGISTRY_URL=
